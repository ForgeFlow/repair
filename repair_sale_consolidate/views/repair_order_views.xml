<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_create_sale_order_from_repairs" model="ir.actions.server">
        <field name="name">Create Quotation</field>
        <field name="model_id" ref="repair.model_repair_order" />
        <field name="binding_model_id" ref="repair.model_repair_order" />
        <field name="state">code</field>
        <field name="code">
            action = env['repair.order'].browse(records._ids).action_create_combined_sale_order()
        </field>
    </record>

    <record id="action_unlink_sale_order_from_repair" model="ir.actions.server">
        <field name="name">Unlink from Quotation</field>
        <field name="model_id" ref="repair.model_repair_order" />
        <field name="binding_model_id" ref="repair.model_repair_order" />
        <field name="state">code</field>
        <field name="code">
            for repair in records:
                if repair.state != 'draft' or (repair.sale_order_id and repair.sale_order_id.state != 'draft'):
                    raise UserError(env._("Both the Repairs and the Quote must be in draft state."))
                repair.write({'sale_order_id': False})
        </field>
    </record>
</odoo>
